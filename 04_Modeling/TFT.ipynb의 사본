,"from sklearn.preprocessing import StandardScaler\n","\n","# 경고 무시\n","import warnings\n","warnings.filterwarnings(\"ignore\")"],"metadata":{"id":"yd6S8xbLNMYM","executionInfo":{"status":"ok","timestamp":1765114135767,"user_tz":-540,"elapsed":21873,"user":{"displayName":"‎전예진(자연과학대학 통계학과)","userId":"08858751459738963247"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"20uOLfRuP_VK"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"67_2-HkB_Gjo"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def run_tft_pipeline(year, batch_size=64, max_epochs=20):\n","    print(f\"\\n{'#'*20} Start TFT Pipeline: {year} {'#'*20}\")\n","\n","    # 1. 데이터 통합\n","    train = globals()[f'train{year}']\n","    valid = globals()[f'valid{year}']\n","    test  = globals()[f'test{year}']\n","\n","    train['split'] = 'train'\n","    valid['split'] = 'valid'\n","    test['split']  = 'test'\n","\n","    data = pd.concat([train, valid, test], ignore_index=True)\n","\n","    # 2. 데이터 클리닝\n","    data['ret'] = pd.to_numeric(data['ret'], errors='coerce')\n","    data = data.replace([np.inf, -np.inf], 0.0).fillna(0.0)\n","\n","    scaler = StandardScaler()\n","    data['ret_scaled'] = scaler.fit_transform(data[['ret']])\n","    ret_mean = scaler.mean_[0]\n","    ret_scale = scaler.scale_[0]\n","    print(f\"Global Scaling Applied. Mean: {ret_mean:.4f}, Std: {ret_scale:.4f}\")\n","\n","    # 3. 전처리 (Time Index)\n","    if 'date' in data.columns:\n","        data['date'] = pd.to_datetime(data['date'])\n","\n","    min_date = data['date'].min()\n","    data['time_idx'] = (data['date'].dt.year - min_date.year) * 12 + (data['date'].dt.month - min_date.month)\n","    data['time_idx'] = data['time_idx'].astype(int)\n","\n","    # 짧은 종목 제거\n","    min_len_req = 13\n","    cnt_per_ticker = data.groupby('ticker')['time_idx'].count()\n","    valid_tickers = cnt_per_ticker[cnt_per_ticker >= min_len_req].index\n","    data = data[data['ticker'].isin(valid_tickers)].reset_index(drop=True)\n","\n","    # ---------------------------------------------------------\n","    # [핵심 수정] 사용자님의 모든 범주형 변수 반영\n","    # ---------------------------------------------------------\n","    # 1. 사용자님이 쓰시던 변수 리스트 그대로 정의\n","    all_cat_cols = ['ticker', 'gvkey', 'permno', 'sic', 'exchcd', 'shrcd', 'ffi49', 'Year', 'Month']\n","\n","    # 2. 데이터에 실제로 존재하는 컬럼만 필터링\n","    exist_cat_cols = [c for c in all_cat_cols if c in data.columns]\n","\n","    # 3. 전부 문자열 -> 카테고리 변환\n","    for c in exist_cat_cols:\n","        data[c] = data[c].astype(str).astype('category')\n","\n","    # 4. TFT에 넣을 변수 역할 구분\n","    # - ID 성격: ticker (group_id로 사용)\n","    # - 시간 성격: Year, Month\n","    # - 기업 특성: sic, exchcd, shrcd, ffi49 (이게 중요함!)\n","\n","    # 기업 특성 변수들만 골라내기 (ID랑 시간 제외)\n","    firm_features = [c for c in exist_cat_cols if c not in ['ticker', 'Year', 'Month']]\n","    # ---------------------------------------------------------\n","\n","    # 4. TimeSeriesDataSet 생성\n","    train_cutoff = data[data['split']=='train']['time_idx'].max()\n","\n","    # 숫자형 피처 자동 추출 (범주형 제외)\n","    exclude = ['ret', 'ret_scaled', 'date', 'time_idx', 'split'] + exist_cat_cols\n","    feature_cols = [c for c in data.columns if c not in exclude and pd.api.types.is_numeric_dtype(data[c])]\n","\n","    max_encoder_length = 12\n","    max_prediction_length = 1\n","\n","    categorical_encoders = {\n","        col: NaNLabelEncoder(add_nan=True) for col in exist_cat_cols\n","    }\n","\n","    training = TimeSeriesDataSet(\n","        data[data['time_idx'] <= train_cutoff],\n","        time_idx=\"time_idx\",\n","        target=\"ret_scaled\",\n","        group_ids=[\"ticker\"],\n","        min_encoder_length=max_encoder_length // 2,\n","        max_encoder_length=max_encoder_length,\n","        min_prediction_length=1,\n","        max_prediction_length=max_prediction_length,\n","\n","        # [수정] 정적 변수: ticker\n","        static_categoricals=[\"ticker\"],\n","\n","        # [수정] 시간따라 변하거나 알 수 있는 변수들\n","        # sic, ffi49 등은 기업이 속한 산업이므로 시간이 지나도 '미리 알 수 있는(known)' 정보로 분류하는 게 일반적입니다.\n","        time_varying_known_categoricals=[c for c in [\"Year\", \"Month\"] + firm_features if c in data.columns],\n","\n","        time_varying_known_reals=[\"time_idx\"],\n","        time_varying_unknown_reals=[\"ret_scaled\"] + feature_cols,\n","\n","        allow_missing_timesteps=True,\n","        target_normalizer=None,\n","        categorical_encoders=categorical_encoders,\n","\n","        add_relative_time_idx=True,\n","        add_target_scales=True,\n","        add_encoder_length=True,\n","    )\n","\n","    validation = TimeSeriesDataSet.from_dataset(training, data[data['split'] != 'test'], predict=True, stop_randomization=True)\n","\n","    train_dataloader = training.to_dataloader(train=True, batch_size=batch_size, num_workers=0)\n","    val_dataloader = validation.to_dataloader(train=False, batch_size=batch_size*10, num_workers=0)\n","\n","    # 5. 모델 학습 (동일)\n","    tft = TemporalFusionTransformer.from_dataset(\n","        training,\n","        learning_rate=0.03,\n","        hidden_size=16,\n","        attention_head_size=1,\n","        dropout=0.1,\n","        hidden_continuous_size=8,\n","        output_size=1,\n","        loss=RMSE(),\n","        log_interval=10,\n","        reduce_on_plateau_patience=4,\n","    )\n","\n","    early_stop_callback = EarlyStopping(monitor=\"val_loss\", min_delta=1e-4, patience=5, verbose=False, mode=\"min\")\n","    lr_logger = LearningRateMonitor()\n","\n","    trainer = pl.Trainer(\n","        max_epochs=max_epochs,\n","        accelerator=\"auto\",\n","        enable_model_summary=True,\n","        gradient_clip_val=0.1,\n","        callbacks=[lr_logger, early_stop_callback],\n","        logger=True\n","    )\n","\n","    trainer.fit(tft, train_dataloaders=train_dataloader, val_dataloaders=val_dataloader)\n","\n","    # 6. 예측 및 결과 저장 (동일)\n","    best_model_path = trainer.checkpoint_callback.best_model_path\n","\n","    # [주의] weights_only=False 필수\n","    best_tft = TemporalFusionTransformer.load_from_checkpoint(best_model_path, weights_only=False)\n","\n","    test_start_idx = data[data['split']=='test']['time_idx'].min()\n","    test_subset = data[data['time_idx'] >= test_start_idx - max_encoder_length]\n","    test_subset = test_subset[test_subset['ticker'].isin(valid_tickers)]\n","\n","    test_ds = TimeSeriesDataSet.from_dataset(training, test_subset, predict=False, stop_randomization=True)\n","    test_dataloader = test_ds.to_dataloader(train=False, batch_size=batch_size*10, num_workers=0)\n","\n","    raw_predictions = best_tft.predict(test_dataloader, mode=\"prediction\")\n","    pred_vals_scaled = raw_predictions.flatten().cpu().numpy()\n","\n","    pred_vals_original = pred_vals_scaled * ret_scale + ret_mean\n","\n","    target_rows = test_subset[test_subset['time_idx'] >= test_start_idx].copy()\n","    target_rows = target_rows.sort_values(by=['ticker', 'time_idx'])\n","\n","    min_len = min(len(pred_vals_original), len(target_rows))\n","\n","    result_df = target_rows.iloc[:min_len][['ticker', 'date']].copy()\n","    result_df['pred_ret'] = pred_vals_original[:min_len]\n","    result_df['true_ret'] = target_rows.iloc[:min_len]['ret'].values\n","\n","    save_dir = os.path.join(base_path, '00_predData', 'TFT_new')\n","    os.makedirs(save_dir, exist_ok=True)\n","    result_df.to_csv(os.path.join(save_dir, f'result_{year}.csv'), index=False)\n","\n","    print(f\"[{year}] Done! Saved.\")\n","    return result_df"],"metadata":{"id":"LZJMkJsk_GmP","executionInfo":{"status":"ok","timestamp":1765114144817,"user_tz":-540,"elapsed":24,"user":{"displayName":"‎전예진(자연과학대학 통계학과)","userId":"08858751459738963247"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["# 2018년 실행\n","\n","results = {}\n","\n","for year in range(2018, 2019):\n","    try:\n","        res_df = run_tft_pipeline(year, batch_size=128, max_epochs=10)\n","        results[year] = res_df\n","    except Exception as e:\n","        print(f\"Error processing {year}: {e}\")"],"metadata":{"id":"w0HGvyjm_LMG","colab":{"base_uri":"https://localhost:8080/","height":999,"referenced_widgets":["4fec547c81ed4514aa256185ed8a6912","73d8aecabc5c4796a84fc17ff976a47d"]},"executionInfo":{"status":"ok","timestamp":1765116371841,"user_tz":-540,"elapsed":1968521,"user":{"displayName":"‎전예진(자연과학대학 통계학과)","userId":"08858751459738963247"}},"outputId":"8f1268d9-1cee-4d10-d519-e3e3322abf27"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","#################### Start TFT Pipeline: 2018 ####################\n","Global Scaling Applied. Mean: 0.0125, Std: 0.1163\n"]},{"output_type":"stream","name":"stderr","text":["INFO: 💡 Tip: For seamless cloud uploads and versioning, try installing [litmodels](https://pypi.org/project/litmodels/) to enable LitModelCheckpoint, which syncs automatically with the Lightning model registry.\n","INFO:lightning.pytorch.utilities.rank_zero:💡 Tip: For seamless cloud uploads and versioning, try installing [litmodels](https://pypi.org/project/litmodels/) to enable LitModelCheckpoint, which syncs automatically with the Lightning model registry.\n","INFO: GPU available: True (cuda), used: True\n","INFO:lightning.pytorch.utilities.rank_zero:GPU available: True (cuda), used: True\n","INFO: TPU available: False, using: 0 TPU cores\n","INFO:lightning.pytorch.utilities.rank_zero:TPU available: False, using: 0 TPU cores\n","INFO: LOCAL_RANK: 0 - CUDA_VISIBLE_DEVICES: [0]\n","INFO:lightning.pytorch.accelerators.cuda:LOCAL_RANK: 0 - CUDA_VISIBLE_DEVICES: [0]\n"]},{"output_type":"display_data","data":{"text/plain":["┏━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━━┳━━━━━━━┓\n","┃\u001b[1;35m \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35m \u001b[0m┃\u001b[1;35m \u001b[0m\u001b[1;35mName                              \u001b[0m\u001b[1